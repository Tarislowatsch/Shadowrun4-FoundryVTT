{
  "type": "module",
  "version": "1.30.0",
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "@stryker-mutator/core": {
      "minimatch": "^11.0.5",
      "qs": "^6.17.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.4.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "sass": "^1.82.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:mutation": "stryker run",
    "build": "vite build",
    "build:full": "npm run build:db && vite build",
    "watch": "vite build --watch",
    "clean": "node --input-type=module -e \"import fs from 'fs'; fs.rmSync('shadowrun4e', {recursive:true,force:true})\"",
    "build:db": "node utility/build-db.js",
    "prepare": "husky",
    "eslint": "eslint",
    "createSymlinks": "node ./tools/create-symlinks.mjs",
    "postinstall": "npm run createSymlinks"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.scss": [
      "prettier --write"
    ]
  }
}
