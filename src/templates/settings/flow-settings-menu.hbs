<div class="flow-settings-menu scrollable">
  <p class="hint">{{localize "sr4.settings.flowSettingsMenu.hint"}}</p>

  {{#unless isGM}}
  <p class="notification warning">{{localize "sr4.settings.flowSettingsMenu.playerNotice"}}</p>
  {{/unless}}

  {{#each sections}}
  <fieldset>
    <legend>{{localize this.label}}</legend>
    {{#each this.fields}}
    <div class="form-group flexcol{{#if this.hidden}} hidden{{/if}}"
      {{#if this.custom}}data-flow-custom{{/if}}>
      <div class="sr4-field-row">
        <label>{{localize this.name}}</label>
        {{#if (eq this.type "checkbox")}}
        <input type="checkbox" name="{{this.key}}" {{#if this.checked}}checked{{/if}}
          {{#if this.disabled}}disabled{{/if}} />
        {{else if (eq this.type "select")}}
        <select name="{{this.key}}"
          {{#if this.controller}}data-flow-controller{{/if}}
          {{#if this.disabled}}disabled{{/if}}>
          {{#each this.choices}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
        {{else if (eq this.type "number")}}
        <input type="number" name="{{this.key}}" value="{{this.value}}"
          min="{{this.min}}" max="{{this.max}}" step="{{this.step}}"
          {{#if this.disabled}}disabled{{/if}} />
        {{else}}
        <input type="text" name="{{this.key}}" value="{{this.value}}"
          {{#if this.disabled}}disabled{{/if}} />
        {{/if}}
      </div>
      <p class="hint">{{localize this.hint}}</p>
    </div>
    {{/each}}
  </fieldset>
  {{/each}}

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="save">
      <i class="fas fa-save"></i> {{localize "sr4.settings.flowSettingsMenu.save"}}
    </button>
    <button type="button" data-action="reset">
      <i class="fas fa-rotate-left"></i> {{localize "sr4.settings.flowSettingsMenu.reset"}}
    </button>
  </footer>
</div>
