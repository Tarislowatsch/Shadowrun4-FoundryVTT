<div
  class="item-card power-card{{#if this.system.suppressed}} suppressed{{/if}}"
  id="{{ this._id }}"
  data-item-id="{{ this._id }}"
  title="{{ this.system.description }}"
>
  {{#> item-card-header
      badgeShow=this.system.suppressed
      badgeClass="suppressed-badge"
      badgeLabel="sr4.power.suppressed"
      badgeTooltip="sr4.power.suppressedHint"}}
    {{#*inline "card-buttons"}}
      <a
        class="item-toggle-equip"
        data-action="togglePowerSuppressed"
        data-tooltip="{{localize 'sr4.power.toggleSuppressed'}}"
      >
        {{#if this.system.suppressed}}
        <i class="fas fa-bolt-slash"></i>
        {{else}}
        <i class="fas fa-bolt"></i>
        {{/if}}
      </a>
    {{/inline}}
  {{/item-card-header}}
  <div class="item-body">
    <span class="item-property">
      <strong>{{localize "sr4.power.totalCost"}}</strong>
      {{ this.system.totalCost }}
    </span>
    <span class="item-property">
      <strong>{{localize "sr4.power.rating"}}</strong>
      {{ this.system.rating }}
    </span>
    {{#if this.system.geas}}
    <span class="item-property">
      <strong>{{localize "sr4.power.geas"}}</strong>
      &#10003;
    </span>
    {{/if}}
    {{#if this.system.source}}
    <span class="item-property">
      <strong>{{localize "sr4.power.source"}}</strong>
      {{ this.system.source }}
    </span>
    {{/if}}
  </div>
  {{> item-card-actions-effects}}
</div>
