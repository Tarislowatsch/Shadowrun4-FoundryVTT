<div class="item-sheet-body">
  {{> item-sheet-header nameKey="sr4.item.name"}}

  <table class="item-stats-table">
    <thead>
      <tr>
        <th>{{localize 'sr4.commlink.response'}}</th>
        <th>{{localize 'sr4.commlink.signal'}}</th>
        <th>{{localize 'sr4.commlink.firewall'}}</th>
        <th>{{localize 'sr4.commlink.os'}}</th>
        <th>{{localize 'sr4.item.avail'}}</th>
        <th>{{localize 'sr4.item.legality'}}</th>
        <th>{{localize 'sr4.item.cost'}}</th>
        {{> item-source-header}}
      </tr>
    </thead>
    <tbody>
      <tr>
        {{> stat-cell name="system.response" value=system.response}}
        {{> stat-cell name="system.signal" value=system.signal}}
        {{> stat-cell name="system.firewall" value=system.firewall}}
        {{> stat-cell name="system.os" value=system.os}}
        {{> stat-cell name="system.avail" value=system.avail type="text"}}
        {{> stat-cell name="system.legality" value=system.legality type="text"}}
        {{> stat-cell name="system.cost" value=system.cost}}
        {{> item-source-cell value=system.source}}
      </tr>
    </tbody>
  </table>

  {{> item-textareas}}
</div>
