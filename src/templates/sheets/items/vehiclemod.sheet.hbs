
  <div class="item-sheet-body">
    {{> item-sheet-header nameKey="sr4.vehiclemod.name"}}

    <table class="item-stats-table">
      <thead>
        <tr>
          <th>{{localize 'sr4.vehiclemod.handlingBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.speedBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.accelBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.armorBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.sensorBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.bodyBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.pilotBonus'}}</th>
          <th>{{localize 'sr4.vehiclemod.slotCost'}}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          {{> stat-cell name="system.handlingBonus" value=system.handlingBonus}}
          {{> stat-cell name="system.speedBonus" value=system.speedBonus}}
          {{> stat-cell name="system.accelBonus" value=system.accelBonus}}
          {{> stat-cell name="system.armorBonus" value=system.armorBonus}}
          {{> stat-cell name="system.sensorBonus" value=system.sensorBonus}}
          {{> stat-cell name="system.bodyBonus" value=system.bodyBonus}}
          {{> stat-cell name="system.pilotBonus" value=system.pilotBonus}}
          {{> stat-cell name="system.slotCost" value=system.slotCost}}
        </tr>
      </tbody>
    </table>

    <table class="item-stats-table">
      <thead>
        <tr>
          <th>{{localize 'sr4.item.rating'}}</th>
          <th>{{localize 'sr4.item.avail'}}</th>
          <th>{{localize 'sr4.item.legality'}}</th>
          <th>{{localize 'sr4.item.cost'}}</th>
          {{> item-source-header}}
        </tr>
      </thead>
      <tbody>
        <tr>
          {{> stat-cell name="system.rating" value=system.rating placeholder="—"}}
          {{> stat-cell name="system.avail" value=system.avail}}
          {{> stat-cell name="system.legality" value=system.legality type="text"}}
          {{> stat-cell name="system.cost" value=system.cost}}
          {{> item-source-cell value=system.source}}
        </tr>
      </tbody>
    </table>

    {{> item-textareas}}
  </div>
