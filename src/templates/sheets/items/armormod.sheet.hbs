
  <div class="item-sheet-body">
    {{> item-sheet-header nameKey="sr4.armormod.name"}}

    <table class="item-stats-table">
      <thead>
        <tr>
          <th>{{localize 'sr4.armormod.ballisticBonus'}}</th>
          <th>{{localize 'sr4.armormod.impactBonus'}}</th>
          <th>{{localize 'sr4.armormod.capacityCost'}}</th>
          <th>{{localize 'sr4.item.rating'}}</th>
          <th>{{localize 'sr4.item.avail'}}</th>
          <th>{{localize 'sr4.item.legality'}}</th>
          <th>{{localize 'sr4.item.cost'}}</th>
          {{> item-source-header}}
        </tr>
      </thead>
      <tbody>
        <tr>
          {{> stat-cell name="system.ballisticBonus" value=system.ballisticBonus}}
          {{> stat-cell name="system.impactBonus" value=system.impactBonus}}
          {{> stat-cell name="system.capacityCost" value=system.capacityCost}}
          {{> stat-cell name="system.rating" value=system.rating placeholder="—"}}
          {{> stat-cell name="system.avail" value=system.avail}}
          {{> stat-cell name="system.legality" value=system.legality type="text"}}
          {{> stat-cell name="system.cost" value=system.cost}}
          {{> item-source-cell value=system.source}}
        </tr>
      </tbody>
    </table>

    {{> item-textareas}}
  </div>
