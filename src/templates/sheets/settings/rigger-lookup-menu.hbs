<div class="rigger-lookup-menu">
  <p class="hint">{{localize "sr4.settings.riggerLookupMenu.hint"}}</p>

  {{#each roles}}
  <div class="form-group">
    <label>{{localize label}}</label>
    <select name="{{key}}">
      {{#each options}}
      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{name}}</option>
      {{/each}}
    </select>
  </div>
  {{/each}}

  <div class="form-group">
    <label>{{localize "sr4.settings.riggerLookupMenu.commandProgram"}}</label>
    <input type="text" name="commandProgram" value="{{commandProgram}}" />
  </div>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="save">
      <i class="fas fa-save"></i> {{localize "sr4.settings.riggerLookupMenu.save"}}
    </button>
    <button type="button" data-action="reset">
      <i class="fas fa-rotate-left"></i> {{localize "sr4.settings.riggerLookupMenu.reset"}}
    </button>
  </footer>
</div>
