<div class="scene-modifiers-menu" style="display:flex; flex-direction:column; gap:12px; padding:8px; box-sizing:border-box;">
  <p class="hint" style="margin:0;">{{localize "sr4.scene.modifiers.hint"}}{{#if sceneName}} — <strong>{{sceneName}}</strong>{{/if}}</p>

  <fieldset style="border:1px solid var(--color-border-light-tertiary); border-radius:4px; padding:8px; display:flex; flex-direction:column; gap:8px;">
    <legend style="padding:0 4px; font-weight:bold;">{{localize "sr4.scene.modifiers.backgroundCount.section"}}</legend>
    {{#each fields}}
    <div class="form-group flexcol" style="gap:2px;">
      <div style="display:flex; align-items:center; gap:8px;">
        <label style="flex:1;">{{localize this.name}}</label>
        {{#if (eq this.type "select")}}
        <select name="{{this.key}}" style="flex:2;">
          {{#each this.choices}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
        {{else}}
        <input type="number" name="{{this.key}}" value="{{this.value}}" step="1" style="flex:2;" />
        {{/if}}
      </div>
      <p class="hint" style="margin:0;">{{localize this.hint}}</p>
    </div>
    {{/each}}
  </fieldset>

  <footer class="sheet-footer flexrow" style="margin-top:8px; gap:8px; flex-shrink:0;">
    <button type="button" data-action="save">
      <i class="fas fa-save"></i> {{localize "sr4.scene.modifiers.save"}}
    </button>
  </footer>
</div>
